{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "compatibility_date": "2026-07-27",
  "compatibility_flags": ["global_fetch_strictly_public"],
  "name": "homegrownhearts",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Serve our own on-brand 404.html for unmatched URLs instead of
    // Cloudflare's bare default. Without this a mistyped link — or a stale
    // link in an outreach email — lands on an unbranded error page, which is
    // the worst possible first impression for a clinic reader.
    "not_found_handling": "404-page",
  },
  "observability": {
    "enabled": true,
  },
}
