---
/**
 * Homepage — shell only.
 *
 * Real copy lands in Phase 3 and the sections in Phase 4. What is here now
 * exists to exercise the design system and the layout shell end to end, so
 * every primitive is rendered at least once and any regression shows up in a
 * build rather than three phases later.
 */

import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import Eyebrow from '../components/Eyebrow.astro';
import Button from '../components/Button.astro';
import StatCard from '../components/StatCard.astro';
import Reveal from '../components/Reveal.astro';
import Photo from '../components/Photo.astro';
import { getLocale, useTranslations, localizePath } from '../i18n/utils';
import { ORG, IMPACT } from '../config';

const locale = getLocale(Astro.url);
const t = useTranslations(locale);
---

<Base
  title="Fresh food for new mothers"
  description="Homegrown Hearts grows fresh produce in Union County, NC and delivers free bundles to pregnant and postpartum mothers through a partner clinic."
>
  <Section accent="grow" surface="cream">
    <Reveal>
      <Eyebrow>{ORG.location.county}, {ORG.location.stateCode}</Eyebrow>
      <h1>Fresh food, grown close to home.</h1>
      <p class="lead">
        We grow produce in a small local garden and pack it into free bundles for pregnant and
        postpartum mothers — delivered through a partner clinic.
      </p>
      <div class="actions">
        <Button href={localizePath('/partners', locale)} size="lg">{t('cta.partner')}</Button>
        <Button href={localizePath('/get-involved', locale)} variant="secondary" size="lg">
          {t('cta.volunteer')}
        </Button>
      </div>
    </Reveal>

    <Reveal delay={120} class="hero-media">
      <Photo photo="hero" eager />
    </Reveal>
  </Section>

  <Section accent="grow" surface="cream" rhythm="tight">
    <Reveal stagger={80} class="gallery">
      <Photo photo="garden" alt="Raised vegetable beds in the Homegrown Hearts garden." />
      <Photo photo="harvest" alt="Freshly picked vegetables in a harvest basket." />
      <Photo photo="bundle" alt="A complete produce bundle, packed and ready for the clinic." />
    </Reveal>
  </Section>

  <Section accent="harvest" surface="sand">
    <Reveal>
      <Eyebrow>{t('nav.impact')}</Eyebrow>
      <h2>Where we are today</h2>
      <p class="lead">{t('impact.starting')}</p>
    </Reveal>

    <Reveal stagger={80} class="stats">
      <StatCard value={String(IMPACT.bundlesDelivered)} label={t('impact.bundles')} />
      <StatCard value={String(IMPACT.mothersServed)} label={t('impact.mothers')} />
      <StatCard value={String(IMPACT.volunteers)} label={t('impact.volunteers')} />
    </Reveal>
  </Section>
</Base>

<style>
  h1 {
    font-size: var(--text-display);
    line-height: var(--text-display--line-height);
    letter-spacing: var(--text-display--letter-spacing);
    color: var(--color-clay);
    max-width: 18ch;
  }

  h2 {
    font-size: var(--text-h2);
    line-height: var(--text-h2--line-height);
    letter-spacing: var(--text-h2--letter-spacing);
    color: var(--color-clay);
  }

  .lead {
    margin-top: 1.25rem;
    max-width: 56ch;
    font-size: var(--text-lead);
    line-height: var(--text-lead--line-height);
    color: var(--color-ink-muted);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.875rem;
    margin-top: 2rem;
  }

  .stats {
    display: grid;
    gap: 2rem;
    margin-top: 3rem;
  }

  .hero-media {
    margin-top: 3rem;
  }

  .gallery {
    display: grid;
    gap: 1.25rem;
  }

  @media (min-width: 40rem) {
    .stats {
      grid-template-columns: repeat(3, 1fr);
    }

    .gallery {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
