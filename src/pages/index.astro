---
/**
 * Homepage — shell + motion.
 *
 * Real copy lands in Phase 3 and the full section set in Phase 4. What is here
 * exercises every primitive and every motion the system provides, so a
 * regression in either shows up in a build rather than three phases later.
 */

import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import Eyebrow from '../components/Eyebrow.astro';
import Button from '../components/Button.astro';
import StatCard from '../components/StatCard.astro';
import Reveal from '../components/Reveal.astro';
import Photo from '../components/Photo.astro';
import WordRise from '../components/WordRise.astro';
import Steps from '../components/Steps.astro';
import type { Step } from '../components/Steps.astro';
import { getLocale, useTranslations, localizePath } from '../i18n/utils';
import { ORG, IMPACT } from '../config';

const locale = getLocale(Astro.url);
const t = useTranslations(locale);

// Placeholder copy — task 4.3 replaces this with the approved wording.
const steps: Step[] = [
  { icon: 'seed', title: 'Grow', body: 'We plant and tend a small garden through the season.' },
  { icon: 'sprout', title: 'Harvest', body: 'Produce is picked the morning it goes out.' },
  { icon: 'basket', title: 'Pack', body: 'Bundles are assembled to a clinic-approved list.' },
  {
    icon: 'heart',
    title: 'Deliver',
    body: 'Our partner clinic hands them to the families it serves.',
  },
];
---

<Base
  title="Fresh food for new mothers"
  description="Homegrown Hearts grows fresh produce in Union County, NC and delivers free bundles to pregnant and postpartum mothers through a partner clinic."
>
  <Section accent="grow" surface="cream">
    <Eyebrow>{ORG.location.county}, {ORG.location.stateCode}</Eyebrow>
    <WordRise text="Fresh food, grown close to home." as="h1" class="hero__title" />
    <Reveal delay={320}>
      <p class="lead">
        We grow produce in a small local garden and pack it into free bundles for pregnant and
        postpartum mothers — delivered through a partner clinic.
      </p>
      <div class="actions">
        <Button href={localizePath('/partners', locale)} size="lg">{t('cta.partner')}</Button>
        <Button href={localizePath('/get-involved', locale)} variant="secondary" size="lg">
          {t('cta.volunteer')}
        </Button>
      </div>
    </Reveal>

    <Reveal delay={120} class="hero-media">
      <Photo photo="hero" eager kenBurns />
    </Reveal>
  </Section>

  <Section accent="grow" surface="cream" rhythm="tight">
    <Reveal>
      <Eyebrow>How it works</Eyebrow>
      <h2>From our garden to a clinic waiting room</h2>
    </Reveal>
    <Steps steps={steps} class="process" />
  </Section>

  <Section accent="harvest" surface="sand" rhythm="tight">
    <Reveal stagger={80} class="gallery">
      <Photo photo="garden" alt="Raised vegetable beds in the Homegrown Hearts garden." />
      <Photo photo="harvest" alt="Freshly picked vegetables in a harvest basket." />
      <Photo photo="bundle" alt="A complete produce bundle, packed and ready for the clinic." />
    </Reveal>
  </Section>

  <Section accent="care" surface="cream">
    <Reveal>
      <Eyebrow>{t('nav.impact')}</Eyebrow>
      <h2>Where we are today</h2>
      <p class="lead">{t('impact.starting')}</p>
    </Reveal>

    <div class="stats">
      <StatCard value={String(IMPACT.bundlesDelivered)} label={t('impact.bundles')} countUp />
      <StatCard value={String(IMPACT.mothersServed)} label={t('impact.mothers')} countUp />
      <StatCard value={String(IMPACT.volunteers)} label={t('impact.volunteers')} countUp />
    </div>
  </Section>
</Base>

<style>
  .hero__title {
    font-size: var(--text-display);
    line-height: var(--text-display--line-height);
    letter-spacing: var(--text-display--letter-spacing);
    color: var(--color-clay);
    max-width: 18ch;
  }

  h2 {
    font-size: var(--text-h2);
    line-height: var(--text-h2--line-height);
    letter-spacing: var(--text-h2--letter-spacing);
    color: var(--color-clay);
    max-width: 22ch;
  }

  .lead {
    margin-top: 1.25rem;
    max-width: 56ch;
    font-size: var(--text-lead);
    line-height: var(--text-lead--line-height);
    color: var(--color-ink-muted);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.875rem;
    margin-top: 2rem;
  }

  .hero-media {
    margin-top: 3rem;
  }

  .process {
    margin-top: 2.5rem;
  }

  .stats,
  .gallery {
    display: grid;
    gap: 2rem;
    margin-top: 3rem;
  }

  .gallery {
    gap: 1.25rem;
    margin-top: 0;
  }

  @media (min-width: 40rem) {
    .stats,
    .gallery {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
