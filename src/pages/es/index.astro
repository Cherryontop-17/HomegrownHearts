---
/**
 * Spanish homepage — mirrors `/` exactly, including every motion.
 *
 * The duplication is temporary. Task 3.9 moves all prose into
 * `src/content/{en,es}/` behind one schema, at which point both locales render
 * from a single component. Until then this file exists so the ES route, the
 * switcher, hreflang, and — critically — every animation against ~20% longer
 * Spanish strings are all exercised by the build rather than assumed to work.
 */

import Base from '../../layouts/Base.astro';
import Section from '../../components/Section.astro';
import Eyebrow from '../../components/Eyebrow.astro';
import Button from '../../components/Button.astro';
import StatCard from '../../components/StatCard.astro';
import Reveal from '../../components/Reveal.astro';
import Photo from '../../components/Photo.astro';
import WordRise from '../../components/WordRise.astro';
import Steps from '../../components/Steps.astro';
import type { Step } from '../../components/Steps.astro';
import { getLocale, useTranslations, localizePath } from '../../i18n/utils';
import { ORG, IMPACT } from '../../config';

const locale = getLocale(Astro.url);
const t = useTranslations(locale);

const steps: Step[] = [
  { icon: 'seed', title: 'Sembrar', body: 'Cuidamos un huerto pequeño durante toda la temporada.' },
  {
    icon: 'sprout',
    title: 'Cosechar',
    body: 'Recogemos las verduras la misma mañana de la entrega.',
  },
  {
    icon: 'basket',
    title: 'Empacar',
    body: 'Armamos cada paquete según una lista aprobada por la clínica.',
  },
  {
    icon: 'heart',
    title: 'Entregar',
    body: 'La clínica asociada los entrega a las familias que atiende.',
  },
];
---

<Base
  title="Alimentos frescos para nuevas madres"
  description="Homegrown Hearts cultiva alimentos frescos en el condado de Union, Carolina del Norte, y entrega paquetes gratuitos a madres embarazadas y recién dadas a luz a través de una clínica asociada."
>
  <Section accent="grow" surface="cream">
    <Eyebrow>Condado de Union, {ORG.location.stateCode}</Eyebrow>
    <WordRise text="Alimentos frescos, cultivados aquí cerca." as="h1" class="hero__title" />
    <Reveal delay={320}>
      <p class="lead">
        Cultivamos verduras en un huerto local y armamos paquetes gratuitos para madres embarazadas
        y recién dadas a luz. La entrega se hace a través de una clínica asociada.
      </p>
      <div class="actions">
        <Button href={localizePath('/partners', locale)} size="lg">{t('cta.partner')}</Button>
        <Button href={localizePath('/get-involved', locale)} variant="secondary" size="lg">
          {t('cta.volunteer')}
        </Button>
      </div>
    </Reveal>

    <Reveal delay={120} class="hero-media">
      <Photo photo="hero" eager kenBurns />
    </Reveal>
  </Section>

  <Section accent="grow" surface="cream" rhythm="tight">
    <Reveal>
      <Eyebrow>Cómo funciona</Eyebrow>
      <h2>De nuestro huerto a la sala de espera de la clínica</h2>
    </Reveal>
    <Steps steps={steps} class="process" />
  </Section>

  <Section accent="harvest" surface="sand" rhythm="tight">
    <Reveal stagger={80} class="gallery">
      <Photo photo="garden" alt="Camas de cultivo en el huerto de Homegrown Hearts." />
      <Photo photo="harvest" alt="Verduras recién cosechadas en una canasta." />
      <Photo photo="bundle" alt="Un paquete de verduras completo, listo para la clínica." />
    </Reveal>
  </Section>

  <Section accent="care" surface="cream">
    <Reveal>
      <Eyebrow>{t('nav.impact')}</Eyebrow>
      <h2>Dónde estamos hoy</h2>
      <p class="lead">{t('impact.starting')}</p>
    </Reveal>

    <div class="stats">
      <StatCard value={String(IMPACT.bundlesDelivered)} label={t('impact.bundles')} countUp />
      <StatCard value={String(IMPACT.mothersServed)} label={t('impact.mothers')} countUp />
      <StatCard value={String(IMPACT.volunteers)} label={t('impact.volunteers')} countUp />
    </div>
  </Section>
</Base>

<style>
  .hero__title {
    font-size: var(--text-display);
    line-height: var(--text-display--line-height);
    letter-spacing: var(--text-display--letter-spacing);
    color: var(--color-clay);
    max-width: 18ch;
  }

  h2 {
    font-size: var(--text-h2);
    line-height: var(--text-h2--line-height);
    letter-spacing: var(--text-h2--letter-spacing);
    color: var(--color-clay);
    max-width: 22ch;
  }

  .lead {
    margin-top: 1.25rem;
    max-width: 56ch;
    font-size: var(--text-lead);
    line-height: var(--text-lead--line-height);
    color: var(--color-ink-muted);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.875rem;
    margin-top: 2rem;
  }

  .hero-media {
    margin-top: 3rem;
  }

  .process {
    margin-top: 2.5rem;
  }

  .stats,
  .gallery {
    display: grid;
    gap: 2rem;
    margin-top: 3rem;
  }

  .gallery {
    gap: 1.25rem;
    margin-top: 0;
  }

  @media (min-width: 40rem) {
    .stats,
    .gallery {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
