---
/**
 * Spanish homepage — shell only, mirroring `/`.
 *
 * The duplication here is temporary. Task 3.9 moves all prose into
 * `src/content/{en,es}/` behind one schema, at which point both locales render
 * from a single page component and a missing translation fails the build.
 * Until then this file exists so the ES route, the switcher, and hreflang are
 * all exercised by the build rather than assumed to work.
 */

import Base from '../../layouts/Base.astro';
import Section from '../../components/Section.astro';
import Eyebrow from '../../components/Eyebrow.astro';
import Button from '../../components/Button.astro';
import StatCard from '../../components/StatCard.astro';
import Reveal from '../../components/Reveal.astro';
import { getLocale, useTranslations, localizePath } from '../../i18n/utils';
import { ORG, IMPACT } from '../../config';

const locale = getLocale(Astro.url);
const t = useTranslations(locale);
---

<Base
  title="Alimentos frescos para nuevas madres"
  description="Homegrown Hearts cultiva alimentos frescos en el condado de Union, Carolina del Norte, y entrega paquetes gratuitos a madres embarazadas y recién dadas a luz a través de una clínica asociada."
>
  <Section accent="grow" surface="cream">
    <Reveal>
      <Eyebrow>Condado de Union, {ORG.location.stateCode}</Eyebrow>
      <h1>Alimentos frescos, cultivados aquí cerca.</h1>
      <p class="lead">
        Cultivamos verduras en un huerto local y armamos paquetes gratuitos para madres embarazadas
        y recién dadas a luz. La entrega se hace a través de una clínica asociada.
      </p>
      <div class="actions">
        <Button href={localizePath('/partners', locale)} size="lg">{t('cta.partner')}</Button>
        <Button href={localizePath('/get-involved', locale)} variant="secondary" size="lg">
          {t('cta.volunteer')}
        </Button>
      </div>
    </Reveal>
  </Section>

  <Section accent="harvest" surface="sand">
    <Reveal>
      <Eyebrow>{t('nav.impact')}</Eyebrow>
      <h2>Dónde estamos hoy</h2>
      <p class="lead">{t('impact.starting')}</p>
    </Reveal>

    <Reveal stagger={80} class="stats">
      <StatCard value={String(IMPACT.bundlesDelivered)} label={t('impact.bundles')} />
      <StatCard value={String(IMPACT.mothersServed)} label={t('impact.mothers')} />
      <StatCard value={String(IMPACT.volunteers)} label={t('impact.volunteers')} />
    </Reveal>
  </Section>
</Base>

<style>
  h1 {
    font-size: var(--text-display);
    line-height: var(--text-display--line-height);
    letter-spacing: var(--text-display--letter-spacing);
    color: var(--color-clay);
    max-width: 18ch;
  }

  h2 {
    font-size: var(--text-h2);
    line-height: var(--text-h2--line-height);
    letter-spacing: var(--text-h2--letter-spacing);
    color: var(--color-clay);
  }

  .lead {
    margin-top: 1.25rem;
    max-width: 56ch;
    font-size: var(--text-lead);
    line-height: var(--text-lead--line-height);
    color: var(--color-ink-muted);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.875rem;
    margin-top: 2rem;
  }

  .stats {
    display: grid;
    gap: 2rem;
    margin-top: 3rem;
  }

  @media (min-width: 40rem) {
    .stats {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
