---
/**
 * The Growing Vine — the site's signature motion.
 *
 * A single continuous stroke runs the full page height, drawing in proportion
 * to scroll progress, sprouting a leaf as it passes each section boundary and
 * terminating in the logo's heart. It doubles as a reading-progress indicator.
 *
 * ── How it draws ──────────────────────────────────────────────────────────
 * `pathLength="1"` normalizes the path, so `stroke-dasharray: 1` and a
 * `stroke-dashoffset` from 1 to 0 draws it exactly, at any page height.
 *
 * Preferred path is CSS `animation-timeline: scroll(root block)`: the browser
 * runs it off the main thread, so it cannot jank no matter what else is
 * happening. Where that is unsupported (Firefox at time of writing, older
 * Safari) a rAF-throttled scroll listener writes a single custom property
 * instead. The JS never runs when CSS can do the job.
 *
 * ── Why the stem and the leaves are separate SVGs ─────────────────────────
 * The stem stretches to the document height with `preserveAspectRatio="none"`,
 * which scales x and y unequally. That would shear anything with a recognisable
 * shape. `vector-effect: non-scaling-stroke` keeps the stem's weight honest
 * under that scale, and the leaves are rendered as their own small, undistorted
 * SVGs positioned at percentages down the track.
 *
 * ── Why it is decorative ──────────────────────────────────────────────────
 * `aria-hidden`. Reading progress is ambient, not information — a screen reader
 * announcing a progress indicator it cannot act on is noise. Nothing here
 * carries meaning that is not also in the text.
 */

interface Props {
  /**
   * Where leaves sprout, as percentages down the page. Roughly align these
   * with section boundaries on the page you are using it on.
   */
  leaves?: number[];
  class?: string;
}

const { leaves = [22, 48, 74], class: className } = Astro.props;

// Gentle S-curve down a 0-1000 box. Kept shallow: a wide sweep would put the
// stroke under the text column on narrow screens.
const STEM = 'M20 0 C 20 120, 62 180, 62 300 S 20 420, 20 540 S 62 700, 62 820 S 26 940, 24 1000';

const LEAF = 'M12 20C7.2 17.4 4 12.8 3.4 6.4C9.8 7.4 13.4 12.4 12 20Z';
---

<div class:list={['vine', className]} aria-hidden="true" data-vine>
  <svg class="vine__stem" viewBox="0 0 80 1000" preserveAspectRatio="none" focusable="false">
    <path class="vine__path" d={STEM} pathLength="1"></path>
  </svg>

  {
    leaves.map((at, i) => (
      <svg
        class="vine__leaf"
        style={`--at:${at}%;--leaf-index:${i}`}
        viewBox="0 0 24 24"
        width="18"
        height="18"
        focusable="false"
      >
        {/* Alternate sides so the vine reads as growing rather than fraying. */}
        <path d={LEAF} transform={i % 2 === 0 ? undefined : 'scale(-1,1) translate(-24,0)'} />
      </svg>
    ))
  }
</div>

<style>
  .vine {
    position: absolute;
    inset-block: 0;
    inset-inline-start: 0;
    width: 80px;
    pointer-events: none;
    /* Behind everything. It is texture, not content. */
    z-index: 0;
    color: var(--color-leaf);
  }

  /* Hidden below the width where it would sit under the text column. The
     content gutter only opens up past this point. */
  @media (max-width: 74rem) {
    .vine {
      display: none;
    }
  }

  .vine__stem {
    width: 100%;
    height: 100%;
    display: block;
  }

  .vine__path {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    /* Holds the stroke at 1.5px despite the non-uniform stretch above. */
    vector-effect: non-scaling-stroke;

    stroke-dasharray: 1;
    /* Fallback path: JS writes --vine-progress. Defaults to 1 so that if the
       script never runs the vine is simply fully drawn, rather than absent. */
    stroke-dashoffset: calc(1 - var(--vine-progress, 1));
  }

  /* Preferred path: driven by scroll position, off the main thread. */
  @supports (animation-timeline: scroll()) {
    .vine__path {
      stroke-dashoffset: 1;
      animation: draw-in linear forwards;
      animation-timeline: scroll(root block);
    }
  }

  .vine__leaf {
    position: absolute;
    inset-inline-start: 34px;
    top: var(--at);
    fill: currentColor;
    stroke: none;
    opacity: 0;
    transform: scale(0.6);
    transform-origin: 12px 20px;
    transition:
      opacity var(--duration-base) var(--ease-out-gentle),
      transform var(--duration-base) var(--ease-overshoot);
  }

  /* Set by the observer once the reader has scrolled past that point. Once
     only — the class is never removed. */
  .vine__leaf.is-open {
    opacity: 0.85;
    transform: scale(1);
  }

  /*
    Reduced motion means the vine is ALREADY DRAWN, not drawn instantly. The
    global kill-switch collapses durations, but a scroll-driven animation is
    positional, so without this the stroke would sit at dashoffset 1 — an
    invisible vine — for a reader who never scrolls.
  */
  @media (prefers-reduced-motion: reduce) {
    .vine__path {
      animation: none;
      stroke-dashoffset: 0;
    }

    .vine__leaf {
      opacity: 0.85;
      transform: none;
      transition: none;
    }
  }
</style>

<script>
  function initVine() {
    const vine = document.querySelector<HTMLElement>('[data-vine]');
    if (!vine) return;

    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const leaves = Array.from(vine.querySelectorAll<SVGElement>('.vine__leaf'));

    // --- Leaves ------------------------------------------------------------
    // Opened by scroll position rather than by IntersectionObserver: each leaf
    // should appear as the DRAWN stroke reaches it, which is a function of page
    // progress, not of the leaf's own visibility.
    const openPassedLeaves = (progress: number) => {
      for (const leaf of leaves) {
        if (leaf.classList.contains('is-open')) continue;
        const at = parseFloat(leaf.style.getPropertyValue('--at')) / 100;
        if (progress >= at) leaf.classList.add('is-open');
      }
    };

    if (reduced) {
      leaves.forEach((leaf) => leaf.classList.add('is-open'));
      return;
    }

    // --- Stroke ------------------------------------------------------------
    // Only drive the stroke from JS where CSS cannot. Where scroll-driven
    // animations exist, the browser is already doing this better.
    const cssDrives =
      typeof CSS !== 'undefined' && CSS.supports && CSS.supports('animation-timeline', 'scroll()');

    let ticking = false;

    const update = () => {
      ticking = false;
      const doc = document.documentElement;
      const scrollable = doc.scrollHeight - doc.clientHeight;
      // A page shorter than the viewport has no progress to report; treat it
      // as complete so the vine is drawn rather than blank.
      const progress = scrollable > 0 ? Math.min(1, Math.max(0, window.scrollY / scrollable)) : 1;

      if (!cssDrives) {
        vine.style.setProperty('--vine-progress', String(progress));
      }
      openPassedLeaves(progress);
    };

    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(update);
    };

    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll, { passive: true });
    update();
  }

  initVine();
  document.addEventListener('astro:page-load', initVine);
</script>
