---
/**
 * Homegrown Hearts logo — heart + sprout.
 *
 * Concept: the sprout rises out of the heart's cleft. It is the terminus of the
 * Growing Vine that runs the page height (see TASKS.md → Animation Spec), so the
 * mark is the payoff of the page's one idea rather than decoration bolted on top.
 *
 * Geometry notes:
 *   - 48x48 grid. The icon set (task 1.10) uses Lucide's 24 grid instead, so
 *     the two are matched optically by eye rather than by a shared unit.
 *   - Every path carries `pathLength="1"`, so a draw-in is
 *     `stroke-dasharray: 1; stroke-dashoffset: 1 -> 0` at any rendered size.
 *     Without it the dash values would have to be re-tuned per size.
 *   - `stroke="currentColor"` throughout: the mark inherits from whatever it
 *     sits in — clay in the header, cream on a dark footer — with no variants.
 *
 * The wordmark is live text, not outlined paths. It stays selectable, it is
 * searchable, it costs no extra bytes because Fraunces is already loaded, and
 * it cannot go blurry at any size.
 *
 * Path data lives in src/brand.js, shared with the favicon/OG generator, so a
 * change to the mark reaches every rendered asset instead of only this file.
 *
 * ── Custom logo override ──────────────────────────────────────────────────
 * If the founders drop a file into `src/assets/brand/`, it replaces the drawn
 * mark everywhere the logo appears. Same `import.meta.glob` idiom as <Photo>
 * and <Flyers>: an empty folder is an absent key, not an error, so the built-in
 * mark stays the fallback and nothing is broken while that folder is empty.
 *
 * The wordmark is NOT replaced — it stays live text beside whichever mark is in
 * use. See `src/assets/brand/README.md` for why a logo with a baked-in wordmark
 * should be supplied as the symbol alone.
 *
 * The custom mark cannot be draw-in animated (there are no known paths to
 * dash), so `animate` is ignored when one is present. It is a decorative
 * flourish, not information.
 */

import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { HEART, STEM, LEAF_LEFT, LEAF_RIGHT } from '../brand.js';

/*
  Preference order: SVG first (resolution-independent at every size the mark is
  used), then PNG, then whatever else is there. Sorting by extension rank keeps
  the choice deterministic if someone leaves two files in the folder.
*/
const EXTENSION_RANK = ['svg', 'png', 'webp', 'avif', 'jpg', 'jpeg'];

const customFiles = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/brand/logo.{svg,png,webp,avif,jpg,jpeg}',
  { eager: true },
);

const customPath = Object.keys(customFiles).sort((a, b) => {
  const rank = (p: string) => {
    const ext = p.split('.').pop()?.toLowerCase() ?? '';
    const i = EXTENSION_RANK.indexOf(ext);
    return i === -1 ? EXTENSION_RANK.length : i;
  };
  return rank(a) - rank(b) || a.localeCompare(b);
})[0];

const customLogo = customPath ? customFiles[customPath].default : null;
/* SVGs pass through `astro:assets` unprocessed, so they go in a plain <img>. */
const customIsSvg = customPath?.toLowerCase().endsWith('.svg') ?? false;

/*
  Narrowed once, here, rather than relying on the JSX ternary to do it —
  TypeScript does not carry the `customLogo ?` guard into the <Image> below, so
  `src` was typed `ImageMetadata | null` and failed `astro check`.

  `widths` on <Image> is 2x the rendered size so the mark stays sharp on a
  retina screen. That note lives out here because a block comment written
  INSIDE an attribute list is parsed as attributes: an earlier version stamped
  `so`, `the`, `mark` and `stays` onto the element as real properties.
*/
const customRaster = !customIsSvg && customLogo ? customLogo : null;

interface Props {
  /** `lockup` = mark + wordmark. `mark` = the symbol alone. */
  variant?: 'lockup' | 'mark';
  /** Filled rather than stroked. Holds up below ~32px, so it is what the
      favicon and OG images use (task 1.11). */
  solid?: boolean;
  /** Rendered size of the mark in px. The wordmark scales with it. */
  size?: number;
  /**
   * Accessible name. Only used when the mark stands alone — in a lockup the
   * wordmark is already readable text, so the SVG is hidden from screen readers
   * to avoid announcing the brand name twice.
   */
  title?: string;
  /** Adds the draw-in hook. The animation itself lands in Phase 2. */
  animate?: boolean;
  class?: string;
}

const {
  variant = 'lockup',
  solid = false,
  size = 40,
  title,
  animate = false,
  class: className,
  ...rest
} = Astro.props;

const isLockup = variant === 'lockup';
// In a lockup the wordmark names the brand, so the symbol is decorative.
const decorative = isLockup || !title;
---

<span
  class:list={['logo', isLockup && 'logo--lockup', className]}
  style={`--mark-size:${size}px`}
  {...rest}
>
  {
    customLogo ? (
      customIsSvg || !customRaster ? (
        <img
          class="mark mark--custom"
          src={customLogo.src}
          width={size}
          height={size}
          alt={decorative ? '' : (title ?? '')}
          aria-hidden={decorative ? 'true' : undefined}
          loading="eager"
          decoding="async"
        />
      ) : (
        <Image
          class="mark mark--custom"
          src={customRaster}
          widths={[size * 2]}
          alt={decorative ? '' : (title ?? '')}
          aria-hidden={decorative ? 'true' : undefined}
          loading="eager"
        />
      )
    ) : (
      <svg
        class:list={['mark', solid && 'mark--solid', animate && 'mark--animate']}
        viewBox="0 0 48 48"
        width={size}
        height={size}
        role={decorative ? undefined : 'img'}
        aria-hidden={decorative ? 'true' : undefined}
        focusable="false"
      >
        {!decorative && <title>{title}</title>}

        {/* Order matters for the draw-in: heart first, then the sprout grows out of it. */}
        <path class="mark__heart" d={HEART} pathLength="1" />
        <path class="mark__stem" d={STEM} pathLength="1" />
        <path class="mark__leaf mark__leaf--left" d={LEAF_LEFT} pathLength="1" />
        <path class="mark__leaf mark__leaf--right" d={LEAF_RIGHT} pathLength="1" />
      </svg>
    )
  }

  {isLockup && <span class="wordmark">Homegrown Hearts</span>}
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    color: inherit;
  }

  .logo--lockup {
    /* Scales with the mark so the lockup holds its proportions at any size. */
    gap: calc(var(--mark-size) * 0.28);
  }

  .mark {
    display: block;
    flex: none;
    fill: none;
    stroke: currentColor;
    stroke-width: 2.4;
    stroke-linecap: round;
    stroke-linejoin: round;
    /* Keeps the stroke weight optically constant if the SVG is ever scaled by
       a transform rather than by width/height. */
    vector-effect: non-scaling-stroke;
  }

  .mark--solid {
    fill: currentColor;
    stroke: none;
  }

  /* A dropped-in file is a raster or an opaque SVG, so none of the stroke
     rules above apply to it. `contain` rather than `cover` so a non-square
     logo is letterboxed inside its box instead of being cropped. */
  .mark--custom {
    width: var(--mark-size);
    height: var(--mark-size);
    object-fit: contain;
    stroke: none;
    fill: none;
  }

  /* The stem stays a stroke even in the solid build — filling a 2px open path
     would collapse it to nothing. */
  .mark--solid .mark__stem {
    fill: none;
    stroke: currentColor;
  }

  .wordmark {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: calc(var(--mark-size) * 0.52);
    letter-spacing: -0.02em;
    line-height: 1;
    white-space: nowrap;
  }

  /* --- Draw-in hook -------------------------------------------------------
     Phase 2 drives this. Declared here so the geometry and its animation stay
     in one file. `pathLength="1"` is what makes a single dash value correct at
     every rendered size. */
  .mark--animate path {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    animation: mark-draw var(--duration-slow) var(--ease-out-gentle) forwards;
  }

  .mark--animate .mark__stem {
    animation-delay: 260ms;
  }
  .mark--animate .mark__leaf--left {
    animation-delay: 380ms;
  }
  .mark--animate .mark__leaf--right {
    animation-delay: 460ms;
  }

  @keyframes mark-draw {
    to {
      stroke-dashoffset: 0;
    }
  }

  /* The global kill-switch in global.css collapses the duration, but that would
     leave the paths sitting at dashoffset 1 — an invisible logo. Reduced motion
     has to mean "already drawn", not "drawn instantly". */
  @media (prefers-reduced-motion: reduce) {
    .mark--animate path {
      stroke-dasharray: none;
      stroke-dashoffset: 0;
      animation: none;
    }
  }
</style>
