---
/**
 * Site footer.
 *
 * Dark, matching the founders' other sites and giving the page a proper base
 * to sit on — a light footer on a light page just trails off.
 *
 * Carries the two statements this site is obliged to make: the non-501(c)(3)
 * status line and the recipient-privacy statement. Both come from the UI
 * dictionary so they are translated, and both are marked in docs/COMPLIANCE.md
 * as not-to-be-reworded.
 *
 * Layout note: the two legal statements sit SIDE BY SIDE in the lower band.
 * Stacked in a single narrow column they read as orphaned fine print with two
 * thirds of the footer empty beside them, which is both ugly and the wrong
 * signal — the status line is a compliance statement, not a disclaimer nobody
 * is meant to read.
 *
 * Everything else reads from `src/config.ts` and renders only when the founders
 * have filled it in. Nothing here invents a placeholder that could read as real.
 */

import { getLocale, localizePath, useTranslations } from '../i18n/utils';
import { ORG, CONTACT, ADVISOR, SOCIAL, has } from '../config';
import Logo from './Logo.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import Icon from './Icon.astro';

const locale = getLocale(Astro.url);
const t = useTranslations(locale);

/*
  Three named columns rather than one long list.

  The footer used to map PRIMARY_NAV, which left every subpage unlinked; then it
  mapped a flattened list, which linked everything but produced a single column
  fifteen items tall. Grouping is what makes a footer scannable — a reader looks
  for the heading first and the link second.

  Written out here rather than derived from the nav tree, because the useful
  footer grouping is not the same shape as the useful header grouping: "For
  clinics" belongs beside "Our partners" down here, and under "Contact" up
  there.
*/
const columns = [
  {
    headingKey: 'footer.explore' as const,
    links: [
      { path: '/#about', labelKey: 'nav.aboutUs' as const },
      { path: '/#how', labelKey: 'nav.how' as const },
      { path: '/#impact', labelKey: 'nav.impact' as const },
      { path: '/garden', labelKey: 'nav.garden' as const },
    ],
  },
  {
    headingKey: 'footer.help' as const,
    links: [
      // #signup, to match the header. See the note in src/nav.ts.
      { path: '/get-involved/volunteer#signup', labelKey: 'nav.volunteer' as const },
      { path: '/get-involved/donate', labelKey: 'nav.donate' as const },
      { path: '/get-involved/drop-off', labelKey: 'nav.dropOff' as const },
    ],
  },
  {
    headingKey: 'footer.more' as const,
    links: [
      { path: '/recipe-ai', labelKey: 'nav.recipeAi' as const },
      { path: '/our-partners', labelKey: 'nav.ourPartners' as const },
      { path: '/partners', labelKey: 'nav.partners' as const },
      { path: '/contact', labelKey: 'nav.getInTouch' as const },
    ],
  },
].map((col) => ({
  heading: t(col.headingKey),
  links: col.links.map((l) => ({ href: localizePath(l.path, locale), label: t(l.labelKey) })),
}));

const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="footer__inner">
    <div class="footer__brand">
      <a class="footer__home" href={localizePath('/', locale)} aria-label={t('a11y.homeLink')}>
        <Logo variant="lockup" size={38} />
      </a>
      <p class="footer__place">
        <Icon name="map-pin" size={16} />
        {
          /* Localised, not raw config — "Union County, NC" in a Spanish page is
            a small tell that the translation stops at the copy files. */
        }
        {t('org.place')}
      </p>
      <p class="footer__blurb">{t('footer.blurb')}</p>
    </div>

    {
      /*
      Every column is a direct child of one grid.

      The three link columns used to live in a nested grid inside a single
      track, which meant they had one column's width to share and auto-fit
      collapsed them into a stack — the footer rendered as one long ladder with
      an empty half. Flat is the only thing that reliably lines them up.
    */
    }
    {
      columns.map((col) => (
        <nav class="footer__col" aria-label={col.heading}>
          <h2 class="footer__heading">{col.heading}</h2>
          <ul class="footer__list">
            {col.links.map((link) => (
              <li>
                <a class="footer__link" href={link.href}>
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      ))
    }

    <div class="footer__col">
      <h2 class="footer__heading">{t('nav.contact')}</h2>
      <ul class="footer__list">
        <li>
          <a class="footer__link" href={`mailto:${CONTACT.email}`}>
            <Icon name="mail" size={16} />
            {CONTACT.email}
          </a>
        </li>
        {
          has.instagram() && (
            <li>
              <a
                class="footer__link"
                href={`https://instagram.com/${SOCIAL.instagram}`}
                target="_blank"
                rel="noopener noreferrer"
              >
                <Icon name="instagram" size={16} />
                {t('footer.followUs')}
              </a>
            </li>
          )
        }
      </ul>

      {
        /* The advisor is the strongest credibility signal here, so it renders as
          soon as one exists — and states the neutral fact until then. */
      }
      <p class="footer__advisor">
        {
          has.advisor() ? (
            <>
              <span class="footer__advisor-role">{t('footer.advisor')}</span>
              <span>
                {ADVISOR.name}
                {ADVISOR.title ? `, ${ADVISOR.title}` : ''}
              </span>
            </>
          ) : (
            t('footer.advisorPending')
          )
        }
      </p>
    </div>
  </div>

  <div class="footer__legal">
    <p class="footer__status">{t('legal.status')}</p>
    <p class="footer__privacy">{t('legal.privacy')}</p>
  </div>

  <div class="footer__base">
    <p class="footer__copy">{`© ${year} ${ORG.name}. ${t('footer.rights')}`}</p>
    <LanguageSwitcher label={t('a11y.langSwitchFooter')} />
  </div>
</footer>

<style>
  .footer {
    background-color: var(--color-ink-deep);
    color: var(--color-ink-inverse);
    /*
      The footer is a <footer>, not a <Section>, so it never picked up the
      inverted text roles that `.section--ink` sets — and the language switcher
      inside it kept rendering at ink-muted, which measures 2.5:1 here. Any
      component placed on a dark surface needs these, so the surface declares
      them rather than each component guessing.
    */
    --text-heading: var(--color-ink-inverse);
    --text-muted: var(--color-line);
    --rule-color: color-mix(in oklab, var(--color-line) 22%, transparent);
    padding-block: clamp(3.5rem, 8vh, 5.5rem) 2rem;
    padding-inline: var(--spacing-gutter);
  }

  .footer__inner,
  .footer__legal,
  .footer__base {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--rule-color);
  }

  .footer__inner {
    display: grid;
    gap: clamp(2rem, 4vw, 3rem);
  }

  /* Two columns of links once there is room for them. */
  @media (min-width: 34rem) {
    .footer__inner {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 60rem) {
    .footer__inner {
      /*
        Brand, then one track per column, all siblings in the same grid.
        The brand gets the wider track because it carries a paragraph; the four
        link columns are equal so their headings align on one baseline.
      */
      grid-template-columns: minmax(0, 1.5fr) repeat(4, minmax(0, 1fr));
      gap: clamp(1.5rem, 3vw, 2.5rem);
      /* Without this the columns stretch to the tallest and their headings
         drift off a shared baseline. */
      align-items: start;
    }

    /* The brand column spans the full height rather than leaving the dead
       space under it that the stacked version had. */
    .footer__brand {
      grid-row: 1;
    }
  }

  .footer__home {
    display: inline-block;
    color: var(--color-ink-inverse);
    text-decoration: none;
  }

  .footer__place {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: 1rem;
    font-size: var(--text-small);
    color: var(--color-line);
  }

  .footer__blurb {
    margin-top: 0.85rem;
    max-width: 34ch;
    font-size: var(--text-small);
    line-height: 1.65;
    color: var(--color-line);
    opacity: 0.85;
  }

  .footer__heading {
    font-family: var(--font-body);
    font-size: var(--text-eyebrow);
    font-weight: 700;
    letter-spacing: var(--text-eyebrow--letter-spacing);
    text-transform: uppercase;
    color: var(--color-clay-soft);
    margin-bottom: 1rem;
  }

  .footer__list {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .footer__link {
    /* The shared inbox is 26 characters with no spaces, and in a 1fr track it
       pushed against the page edge. Breaking it is better than widening the
       column for one string. */
    overflow-wrap: anywhere;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    /* 44px targets — this is where thumbs land on mobile. */
    min-height: 44px;
    font-size: var(--text-small);
    color: var(--color-ink-inverse);
    text-decoration: none;
    opacity: 0.86;
    border-bottom: 1px solid transparent;
    transition:
      opacity var(--duration-fast) var(--ease-out-soft),
      border-color var(--duration-fast) var(--ease-out-soft);
  }

  .footer__link:hover {
    opacity: 1;
    border-bottom-color: currentColor;
  }

  .footer__advisor {
    margin-top: 1.25rem;
    font-size: var(--text-small);
    line-height: 1.6;
    color: var(--color-line);
    display: flex;
    flex-direction: column;
  }

  .footer__advisor-role {
    font-weight: 600;
    color: var(--color-ink-inverse);
  }

  /* --- Legal band ---------------------------------------------------------
     Two columns, so the statements use the footer's width instead of hugging
     the left edge with the rest of it empty. */
  .footer__legal {
    display: grid;
    gap: 1.25rem 3rem;
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid color-mix(in oklab, var(--color-line) 22%, transparent);
  }

  @media (min-width: 52rem) {
    .footer__legal {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .footer__status,
  .footer__privacy {
    font-size: var(--text-small);
    line-height: 1.65;
    color: var(--color-line);
  }

  /* The status line is a compliance statement, not fine print. Full-strength
     text so it cannot be mistaken for a disclaimer nobody is meant to read. */
  .footer__status {
    color: var(--color-ink-inverse);
  }

  .footer__base {
    margin-top: 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid color-mix(in oklab, var(--color-line) 14%, transparent);
  }

  .footer__copy {
    font-size: var(--text-small);
    color: var(--color-line);
    opacity: 0.8;
  }
</style>
