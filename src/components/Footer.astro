---
/**
 * Site footer.
 *
 * Carries the two things this site is legally and ethically obliged to say:
 * the non-501(c)(3) status line and the recipient-privacy statement. Both come
 * from the UI dictionary so they are translated, and both are marked in
 * docs/COMPLIANCE.md as not-to-be-reworded.
 *
 * Everything else — contact, socials, advisor — reads from `src/config.ts` and
 * renders only when the founders have filled it in. Nothing here invents a
 * placeholder that could read as real.
 */

import { getLocale, localizePath, useTranslations } from '../i18n/utils';
import { PRIMARY_NAV } from '../nav';
import { ORG, CONTACT, ADVISOR, SOCIAL, has } from '../config';
import Logo from './Logo.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';

const locale = getLocale(Astro.url);
const t = useTranslations(locale);

const items = PRIMARY_NAV.map((item) => ({
  href: localizePath(item.path, locale),
  label: t(item.labelKey),
}));

const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="footer__inner">
    <div class="footer__brand">
      <a class="footer__home" href={localizePath('/', locale)} aria-label={t('a11y.homeLink')}>
        <Logo variant="lockup" size={36} />
      </a>
      <p class="footer__place">
        {ORG.location.town}, {ORG.location.county}, {ORG.location.stateCode}
      </p>
    </div>

    <nav class="footer__col" aria-label={t('a11y.mainNav')}>
      <h2 class="footer__heading">{ORG.name}</h2>
      <ul class="footer__list">
        {
          items.map((item) => (
            <li>
              <a class="footer__link" href={item.href}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="footer__col">
      <h2 class="footer__heading">{t('nav.contact')}</h2>
      <ul class="footer__list">
        <li>
          <a class="footer__link" href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a>
        </li>
        {
          has.instagram() && (
            <li>
              <a
                class="footer__link"
                href={`https://instagram.com/${SOCIAL.instagram}`}
                target="_blank"
                rel="noopener noreferrer"
              >
                {t('footer.followUs')}
              </a>
            </li>
          )
        }
      </ul>

      {
        /* Named advisor is the strongest credibility signal here, so it renders
          as soon as one exists — and states the neutral fact until then. */
      }
      <p class="footer__advisor">
        {
          has.advisor() ? (
            <>
              <span class="footer__advisor-role">{t('footer.advisor')}</span>
              <span>
                {ADVISOR.name}
                {ADVISOR.title ? `, ${ADVISOR.title}` : ''}
              </span>
            </>
          ) : (
            t('footer.advisorPending')
          )
        }
      </p>
    </div>

    <div class="footer__col">
      <h2 class="footer__heading">{t('a11y.langSwitch')}</h2>
      <LanguageSwitcher layout="stacked" />
    </div>
  </div>

  <div class="footer__legal">
    <p class="footer__status">{t('legal.status')}</p>
    <p class="footer__privacy">{t('legal.privacy')}</p>
    <p class="footer__copy">
      {`© ${year} ${ORG.name}.`}
      {t('footer.rights')}
    </p>
  </div>
</footer>

<style>
  .footer {
    background-color: var(--color-parchment);
    border-top: 1px solid var(--color-line);
    padding-block: var(--spacing-section-tight) 2.5rem;
    padding-inline: var(--spacing-gutter);
  }

  .footer__inner {
    display: grid;
    gap: 2.5rem;
    max-width: var(--container-page);
    margin-inline: auto;
  }

  @media (min-width: 40rem) {
    .footer__inner {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 64rem) {
    .footer__inner {
      grid-template-columns: 1.4fr repeat(3, 1fr);
      gap: 2rem;
    }
  }

  .footer__home {
    display: inline-block;
    color: var(--color-clay);
    text-decoration: none;
  }

  .footer__place {
    margin-top: 0.75rem;
    font-size: var(--text-small);
    color: var(--color-ink-muted);
  }

  .footer__heading {
    font-family: var(--font-body);
    font-size: var(--text-eyebrow);
    font-weight: 700;
    letter-spacing: var(--text-eyebrow--letter-spacing);
    text-transform: uppercase;
    color: var(--color-ink-muted);
    margin-bottom: 0.875rem;
  }

  .footer__list {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .footer__link {
    display: inline-flex;
    align-items: center;
    /* 44px targets in the footer too — this is where thumbs land on mobile. */
    min-height: 44px;
    font-size: var(--text-small);
    color: var(--color-ink);
    text-decoration: none;
    /* Underline drawn with a border so it can animate without reflow. */
    border-bottom: 1px solid transparent;
    transition:
      color var(--duration-fast) var(--ease-out-soft),
      border-color var(--duration-fast) var(--ease-out-soft);
  }

  .footer__link:hover {
    color: var(--color-clay);
    border-bottom-color: currentColor;
  }

  .footer__advisor {
    margin-top: 1.25rem;
    font-size: var(--text-small);
    color: var(--color-ink-muted);
    display: flex;
    flex-direction: column;
  }

  .footer__advisor-role {
    font-weight: 600;
    color: var(--color-ink);
  }

  .footer__legal {
    max-width: var(--container-page);
    margin-inline: auto;
    margin-top: 2.5rem;
    padding-top: 1.75rem;
    border-top: 1px solid var(--color-line);
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }

  .footer__status,
  .footer__privacy {
    max-width: 60ch;
    font-size: var(--text-small);
    color: var(--color-ink-muted);
  }

  /* The status line is a compliance statement, not fine print. It gets the
     same weight as body copy so it cannot be mistaken for a disclaimer
     nobody is meant to read. */
  .footer__status {
    color: var(--color-ink);
  }

  .footer__copy {
    margin-top: 0.5rem;
    font-size: var(--text-small);
    color: var(--color-ink-muted);
  }
</style>
