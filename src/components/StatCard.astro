---
/**
 * A single number with its label and, where the number came from research
 * rather than our own records, its source.
 *
 * The source slot is deliberately prominent. For the primary audience — clinic
 * staff reading a cold email from two 15-year-olds — a cited number is the
 * difference between a claim and evidence. An uncited statistic on this site is
 * a liability, so `source` is part of the primitive rather than something a
 * page remembers to add.
 */

interface Props {
  /** The number itself. String, so "3 in 5" and "0" both work. */
  value: string;
  /** What the number counts. */
  label: string;
  /** Short attribution, e.g. "CDC, 2024". Omit for our own impact numbers. */
  source?: string;
  /** Links the source. Opens in a new tab. */
  sourceHref?: string;
  /** Hook for the Phase 2 count-up. Ignored until then. */
  countUp?: boolean;
  class?: string;
}

const {
  value,
  label,
  source,
  sourceHref,
  countUp = false,
  class: className,
  ...rest
} = Astro.props;
---

<div class:list={['stat', className]} {...rest}>
  {
    /*
    The rendered text is always the FINAL value, never a zero the script counts
    up from. If the script never runs — no JS, an error, a crawler — the number
    is simply correct. An animation must not be load-bearing for the content.
  */
  }
  <p class="stat__value" data-count-up={countUp ? value : undefined}>{value}</p>
  <p class="stat__label">{label}</p>
  {countUp && <span class="stat__bar" aria-hidden="true" />}
  {
    source && (
      <p class="stat__source">
        {sourceHref ? (
          <a href={sourceHref} target="_blank" rel="noopener noreferrer">
            {source}
          </a>
        ) : (
          source
        )}
      </p>
    )
  }
</div>

<style>
  .stat {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .stat__value {
    font-family: var(--font-display);
    font-size: var(--text-h1);
    font-weight: 600;
    line-height: 1;
    letter-spacing: var(--text-h1--letter-spacing);
    color: var(--accent, var(--text-heading));
    /* Reserves the line box before a count-up runs, so animating the digits
       cannot shift the layout underneath. */
    min-height: 1em;
    /* Tabular figures stop the number jittering as digits change. */
    font-variant-numeric: tabular-nums;
  }

  .stat__label {
    font-size: var(--text-body);
    font-weight: 600;
    color: var(--text-heading);
  }

  .stat__source {
    font-size: var(--text-small);
    color: var(--text-muted);
  }

  .stat__source a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 0.2em;
    text-decoration-color: var(--color-line-strong);
    transition: text-decoration-color var(--duration-fast) var(--ease-out-soft);
  }

  .stat__source a:hover {
    text-decoration-color: currentColor;
  }

  /* --- Bar ----------------------------------------------------------------
     Grows from its baseline. `scaleY` on a fixed-height element, not an
     animated `height`, so it never triggers layout and never contributes CLS. */
  .stat__bar {
    display: block;
    height: 3px;
    width: 100%;
    max-width: 6rem;
    margin-top: 0.875rem;
    border-radius: 2px;
    background-color: var(--accent, var(--color-clay));
    opacity: 0.35;
    transform-origin: left bottom;
  }

  :global(.js) .stat__bar {
    transform: scaleX(0);
    transform-origin: left center;
  }

  :global(.js) .stat.is-counted .stat__bar {
    transform: scaleX(1);
    transition: transform var(--duration-slow) var(--ease-out-gentle);
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.js) .stat__bar,
    :global(.js) .stat.is-counted .stat__bar {
      transform: none;
      transition: none;
    }
  }
</style>

<script>
  /**
   * Count-up.
   *
   * Counts to the number already in the DOM rather than replacing it, so the
   * text is correct before, during, and after. Bails out entirely under reduced
   * motion, and for values that are not plain integers ("3 in 5"), where
   * counting would be meaningless.
   */
  function initCountUp() {
    // `:not(.is-counted)` so a second call cannot start a second rAF loop on
    // a counter that is already running.
    const stats = document.querySelectorAll<HTMLElement>('[data-count-up]:not(.is-counted)');
    if (stats.length === 0) return;

    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const run = (el: HTMLElement) => {
      el.classList.add('is-counted');
      const card = el.closest<HTMLElement>('.stat');
      card?.classList.add('is-counted');

      const target = Number(el.dataset.countUp);
      // Not a countable number, or zero — nothing to count. The bar still grows.
      if (!Number.isFinite(target) || target === 0 || reduced) return;

      const DURATION = 600; // the motion budget's ceiling
      const start = performance.now();
      // ease-out cubic: fast then settling, which reads as arriving at a value
      // rather than ticking toward one.
      const ease = (t: number) => 1 - Math.pow(1 - t, 3);

      const tick = (now: number) => {
        const t = Math.min(1, (now - start) / DURATION);
        el.textContent = String(Math.round(ease(t) * target));
        if (t < 1) requestAnimationFrame(tick);
        else el.textContent = String(target);
      };

      requestAnimationFrame(tick);
    };

    if (!('IntersectionObserver' in window)) {
      stats.forEach(run);
      return;
    }

    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          run(entry.target as HTMLElement);
          // Once only. Re-counting on scroll-up is exactly the pattern the
          // motion budget forbids.
          observer.unobserve(entry.target);
        }
      },
      { threshold: 0.6 },
    );

    stats.forEach((el) => observer.observe(el));
  }

  initCountUp();
  document.addEventListener('astro:page-load', initCountUp);
</script>
