---
/**
 * Section label above a heading.
 *
 * Two shapes:
 *   - `pill` (default) — a tinted rounded badge. The idiom used across the
 *     founders' other sites, and what reads as a current product page.
 *   - `rule` — the hairline-and-caps treatment, kept for places where a badge
 *     would be too loud (inside cards, in the footer).
 *
 * Renders a plain <p>. It is a label, not a heading — putting it in an <h*>
 * would inject a level into the outline that means nothing to a screen reader
 * working through the page structure.
 */

interface Props {
  /** Defaults to the section's seasonal `--accent`. */
  color?: 'accent' | 'clay' | 'muted';
  /** Badge or hairline. */
  variant?: 'pill' | 'rule';
  /** Center it, for centered section headers. */
  align?: 'start' | 'center';
  class?: string;
}

const {
  color = 'accent',
  variant = 'pill',
  align = 'start',
  class: className,
  ...rest
}: Props = Astro.props;
---

<p
  class:list={[
    'eyebrow',
    `eyebrow--${color}`,
    `eyebrow--${variant}`,
    align === 'center' && 'eyebrow--center',
    className,
  ]}
  {...rest}
>
  {variant === 'rule' && <span class="eyebrow__mark" aria-hidden="true" />}
  <slot />
</p>

<style>
  .eyebrow {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    margin-bottom: 1rem;
    font-family: var(--font-body);
    font-size: var(--text-eyebrow);
    font-weight: 600;
    line-height: var(--text-eyebrow--line-height);
    letter-spacing: var(--text-eyebrow--letter-spacing);
    text-transform: uppercase;
  }

  /* --- Pill --------------------------------------------------------------
     `inline-flex` and `align-self: flex-start` so the badge hugs its text
     rather than stretching the width of the column. */
  .eyebrow--pill {
    display: inline-flex;
    align-self: flex-start;
    padding: 0.45rem 0.9rem;
    border-radius: var(--radius-pill);
    /*
      Tinted from the section's accent so the badge shifts with the seasonal
      drift — but mixed over the CARD color, not over the band.

      Mixing over the band darkens it, and darkening the background of colored
      text lowers contrast. `harvest` on parchment starts at 4.71:1 and any
      tint at all pushed it under 4.5, at every opacity down to 6%. Tinting
      over white raises the background instead, so the worst pairing is 5.16:1.
    */
    background-color: color-mix(in oklab, var(--accent, var(--color-clay)) 10%, var(--color-card));
    border: 1px solid color-mix(in oklab, var(--accent, var(--color-clay)) 24%, var(--color-card));
  }

  /* A 12% tint of the accent is nearly invisible on the dark band. */
  :global(.section--ink) .eyebrow--pill {
    background-color: color-mix(in oklab, var(--accent, var(--color-clay)) 20%, transparent);
    border-color: color-mix(in oklab, var(--accent, var(--color-clay)) 38%, transparent);
  }

  /*
    Same failure the CTA cards shipped with once, in a different component.

    On the green band `--accent` inverts to cream, and the pill rule above mixes
    the accent into --color-card (#ffffff). Cream into white is white, and the
    label is ALSO the accent — so "Get involved" rendered as cream on white at
    1.02:1: a blank badge on the CTA band. Mixing over the band instead keeps it
    in the green family and puts the label at ~6:1.

    Any surface that inverts the text roles needs its own rule here. Mixing over
    --color-card is only safe while the label is dark.
  */
  :global(.section--garden) .eyebrow--pill {
    background-color: color-mix(in oklab, var(--color-ink-inverse) 16%, transparent);
    border-color: color-mix(in oklab, var(--color-ink-inverse) 40%, transparent);
  }

  .eyebrow--center {
    align-self: center;
    margin-inline: auto;
  }

  .eyebrow--accent {
    color: var(--accent, var(--color-clay));
  }
  .eyebrow--clay {
    color: var(--color-clay);
  }
  .eyebrow--muted {
    color: var(--text-muted);
  }

  /* --- Rule --------------------------------------------------------------
     Short hairline instead of a bullet — quieter, and it echoes the vine. */
  .eyebrow__mark {
    width: 1.5rem;
    height: 1px;
    flex: none;
    background-color: currentColor;
    opacity: 0.55;
  }
</style>
