---
/**
 * Supply wishlist — a filterable grid of what we can actually use.
 *
 * ── The job this does ─────────────────────────────────────────────────────
 * A donor arrives wanting to help and leaves if the answer is a paragraph. The
 * grid answers "what do I buy" in one screen, and the filter exists because the
 * list mixes three unlike things — seed and seedlings, tools, packaging — and a
 * hardware-store donor should not have to read past seven vegetables.
 *
 * ── Money ─────────────────────────────────────────────────────────────────
 * COMPLIANCE Rule 2: we accept supplies only, never money. The section carries
 * that line as a permanent note rather than leaving it to the page around it,
 * because this is the one component a donor might reach directly from a shared
 * anchor link.
 *
 * ── Filtering without a framework ─────────────────────────────────────────
 * Real <button>s toggling a `hidden` attribute. No client framework, no state
 * library, ~30 lines. If the script never runs, every item is visible and the
 * filter bar is hidden by CSS (`.js` gate), so the fallback is the full list
 * rather than a row of dead buttons.
 *
 * `hidden` rather than `display:none` via a class, so filtered-out items leave
 * the accessibility tree too — a screen reader should not find items the
 * visible filter says are not there.
 */

import Icon from './Icon.astro';
import Reveal from './Reveal.astro';
import type { IconName } from '../icons';

interface Supply {
  icon?: string;
  title: string;
  body?: string;
  /** Quantity or note, e.g. "6 plants". */
  value?: string;
  /** Translated group label. Drives the filter bar. */
  group?: string;
}

interface Props {
  items: Supply[];
  /** Label for the "show everything" filter button. */
  allLabel: string;
  /** Accessible name for the filter group, e.g. "Filter supplies by type". */
  filterLabel: string;
  /**
   * Announced after a filter click. `{shown}` and `{total}` are substituted.
   * A template rather than a composed string because the word order around the
   * numbers differs between English and Spanish.
   */
  countLabel: string;
  class?: string;
}

const {
  items,
  allLabel,
  filterLabel,
  countLabel,
  class: className,
  ...rest
}: Props = Astro.props;

/*
  Groups in first-appearance order rather than alphabetical, so the YAML
  controls the order of the filter bar and a translator cannot reorder it by
  accident just by translating a word.
*/
const groups = [...new Set(items.map((i) => i.group).filter((g): g is string => Boolean(g)))];

/** Stable, ASCII filter key — the translated label is not safe in an attribute. */
const slug = (s: string) =>
  s
    .toLowerCase()
    .normalize('NFD')
    // Strips the combining marks NFD just split off, so "Jardinería" and
    // "Jardineria" produce the same key. Written as escapes rather than as
    // literal combining characters, which are invisible in an editor.
    .replace(/[\u0300-\u036f]/g, '')
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-|-$/g, '');
---

<div class:list={['wishlist', className]} {...rest}>
  {
    groups.length > 1 && (
      <div class="wishlist__filters" role="group" aria-label={filterLabel}>
        <button type="button" class="chip is-active" data-filter="all" aria-pressed="true">
          {allLabel}
        </button>
        {groups.map((g) => (
          <button type="button" class="chip" data-filter={slug(g)} aria-pressed="false">
            {g}
          </button>
        ))}
      </div>
    )
  }

  <Reveal stagger={60} class="wishlist__grid">
    {
      items.map((item) => (
        <article class="supply" data-group={item.group ? slug(item.group) : 'all'}>
          <span class="supply__icon">
            <Icon name={(item.icon ?? 'leaf') as IconName} size={24} />
          </span>

          <div class="supply__text">
            <h3 class="supply__title">{item.title}</h3>
            {item.body && <p class="supply__body">{item.body}</p>}
          </div>

          {item.value && <span class="supply__qty">{item.value}</span>}
        </article>
      ))
    }
  </Reveal>

  {/*
    Announces the result of a filter click. Without this a keyboard or screen
    reader user presses "Tools" and gets no feedback that anything changed.
  */}
  <p
    class="sr-only"
    role="status"
    aria-live="polite"
    data-wishlist-status
    data-count-template={countLabel}
  >
  </p>
</div>

<style>
  /* ================= FILTER BAR ======================================== */
  .wishlist__filters {
    /* Hidden until the script confirms it can actually filter. */
    display: none;
    flex-wrap: wrap;
    gap: 0.5rem;
    justify-content: center;
    margin-top: var(--spacing-block);
  }

  :global(.js) .wishlist__filters {
    display: flex;
  }

  .chip {
    min-height: 44px; /* the touch-target floor used across the site */
    padding: 0.5rem 1.1rem;
    border-radius: var(--radius-pill);
    border: 1px solid var(--color-line-strong);
    background-color: transparent;
    font-family: var(--font-body);
    font-size: var(--text-small);
    font-weight: 600;
    color: var(--color-ink);
    cursor: pointer;
    transition:
      background-color var(--duration-fast) var(--ease-out-soft),
      border-color var(--duration-fast) var(--ease-out-soft),
      color var(--duration-fast) var(--ease-out-soft);
  }

  .chip:hover {
    border-color: var(--color-garden);
    color: var(--color-garden-deep);
  }

  .chip.is-active {
    background-color: var(--color-garden);
    border-color: var(--color-garden);
    color: var(--color-ink-inverse);
  }

  .chip:focus-visible {
    outline: 2px solid var(--color-clay);
    outline-offset: 2px;
  }

  /* ================= GRID ============================================== */
  .wishlist__grid {
    display: grid;
    gap: 0.875rem;
    margin-top: 1.5rem;
  }

  @media (min-width: 40rem) {
    .wishlist__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 64rem) {
    .wishlist__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .supply {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.9rem;
    padding: 1.1rem 1.25rem;
    border-radius: var(--radius-lg);
    background-color: var(--color-card);
    border: 1px solid var(--color-line);
    transition:
      transform var(--duration-fast) var(--ease-out-soft),
      border-color var(--duration-fast) var(--ease-out-soft),
      box-shadow var(--duration-fast) var(--ease-out-soft);
  }

  .supply:hover {
    transform: translateY(-2px);
    border-color: color-mix(in oklab, var(--accent, var(--color-clay)) 35%, var(--color-line));
    box-shadow: var(--shadow-soft);
  }

  .supply[hidden] {
    display: none;
  }

  .supply__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    flex: none;
    border-radius: var(--radius-md);
    background-color: color-mix(in oklab, var(--accent, var(--color-clay)) 11%, transparent);
    color: var(--accent, var(--color-clay));
  }

  .supply__title {
    font-family: var(--font-display);
    font-size: 1.0625rem;
    line-height: 1.3;
    color: var(--text-heading);
  }

  .supply__body {
    margin-top: 0.15rem;
    font-size: var(--text-small);
    line-height: 1.5;
    color: var(--text-muted);
  }

  .supply__qty {
    flex: none;
    padding: 0.25rem 0.6rem;
    border-radius: var(--radius-pill);
    background-color: var(--color-sand);
    font-size: 0.8125rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    color: var(--color-ink-muted);
    white-space: nowrap;
  }

  @media (prefers-reduced-motion: reduce) {
    .supply,
    .chip {
      transition: none;
    }
    .supply:hover {
      transform: none;
    }
  }
</style>

<script>
  /**
   * Filter the supply grid.
   *
   * `aria-pressed` on the chips carries the toggle state, and a polite live
   * region announces the new count — a filter that changes the page silently is
   * unusable without sight of it.
   */
  function initWishlist() {
    document.querySelectorAll<HTMLElement>('.wishlist').forEach((root) => {
      if (root.dataset.wishlistBound === 'true') return;
      root.dataset.wishlistBound = 'true';

      const chips = root.querySelectorAll<HTMLButtonElement>('[data-filter]');
      const cards = root.querySelectorAll<HTMLElement>('[data-group]');
      const status = root.querySelector<HTMLElement>('[data-wishlist-status]');

      chips.forEach((chip) => {
        chip.addEventListener('click', () => {
          const filter = chip.dataset.filter;

          chips.forEach((c) => {
            const active = c === chip;
            c.classList.toggle('is-active', active);
            c.setAttribute('aria-pressed', String(active));
          });

          let shown = 0;
          cards.forEach((card) => {
            const match = filter === 'all' || card.dataset.group === filter;
            // `hidden` removes it from the a11y tree as well as from view.
            card.toggleAttribute('hidden', !match);
            if (match) shown += 1;
          });

          if (status) {
            const template = status.dataset.countTemplate ?? '{shown} / {total}';
            status.textContent = template
              .replace('{shown}', String(shown))
              .replace('{total}', String(cards.length));
          }
        });
      });
    });
  }

  initWishlist();
  document.addEventListener('astro:page-load', initWishlist);
</script>
