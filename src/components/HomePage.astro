---
/**
 * The homepage. Rendered entirely from `src/content/pages/<locale>/home.yaml`.
 *
 * Editorial layout. What makes it read as a publication rather than a template:
 *
 *   - SCALE CONTRAST. The hero runs at --text-mega (up to 8.5rem) against
 *     section headings at --text-display. When everything is the same size,
 *     nothing is emphasised and the page reads flat.
 *   - ASYMMETRY. Sections offset against a 12-column grid instead of stacking
 *     centred blocks, so the eye has somewhere to travel.
 *   - PACE. A full-bleed photograph and one deliberately dark band interrupt
 *     the run of cream sections, giving the page chapters rather than a
 *     uniform rhythm.
 *   - FOLIOS. 01 / 02 / 03 in the margin. Cheap, and it helps a reader keep
 *     their place on a long page.
 *
 * Both `/` and `/es/` render this, so a structural change cannot land in
 * English and be forgotten in Spanish.
 */

import Base from '../layouts/Base.astro';
import Section from './Section.astro';
import Eyebrow from './Eyebrow.astro';
import Button from './Button.astro';
import StatCard from './StatCard.astro';
import Reveal from './Reveal.astro';
import Photo from './Photo.astro';
import WordRise from './WordRise.astro';
import Steps from './Steps.astro';
import Cards from './Cards.astro';
import Botanical from './Botanical.astro';
import type { Step } from './Steps.astro';

import { getCopy, section, assertParity } from '../copy';
import { localizePath, useTranslations } from '../i18n/utils';
import { IMPACT } from '../config';
import type { Locale } from '../config';
import type { IconName } from '../icons';

interface Props {
  locale: Locale;
}

const { locale }: Props = Astro.props;

await assertParity();

const copy = await getCopy('home', locale);
const t = useTranslations(locale);

const why = section(copy, 'why');
const how = section(copy, 'how');
const bundle = section(copy, 'bundle');
const founders = section(copy, 'founders');
const impact = section(copy, 'impact');
const cta = section(copy, 'cta');

const steps: Step[] = (how.items ?? []).map((item) => ({
  icon: (item.icon ?? 'leaf') as IconName,
  title: item.title,
  body: item.body ?? '',
}));

const impactStats = [
  { value: IMPACT.bundlesDelivered, label: t('impact.bundles') },
  { value: IMPACT.mothersServed, label: t('impact.mothers') },
  { value: IMPACT.volunteers, label: t('impact.volunteers') },
];
---

<Base title={copy.title} description={copy.description} transparentHeader>
  {/* ============ HERO — full bleed, type over photograph ============== */}
  <section class="hero">
    <div class="hero__media">
      <Photo photo="hero" eager kenBurns scrim aspect="16 / 10" class="hero__photo" />
    </div>

    <div class="hero__content">
      {copy.hero?.eyebrow && <p class="hero__eyebrow">{copy.hero.eyebrow}</p>}
      <WordRise text={copy.hero?.title ?? ''} as="h1" class="hero__title" />
      <Reveal delay={420}>
        {copy.hero?.lead && <p class="hero__lead">{copy.hero.lead}</p>}
        <div class="hero__actions">
          {
            (copy.hero?.ctas ?? []).map((c) => (
              <Button
                href={localizePath(c.href, locale)}
                variant={c.primary ? 'primary' : 'secondary'}
                size="lg"
                class={c.primary ? undefined : 'btn-on-dark'}
              >
                {c.label}
              </Button>
            ))
          }
        </div>
      </Reveal>
    </div>
  </section>

  {/* ============ 01 — WHY. Asymmetric: heading left, prose offset ===== */}
  <Section accent="grow" surface="cream" id={why.id} numeral="01" rhythm="loose">
    <Reveal stagger={130} class="offset">
      <div class="offset__lead">
        {why.eyebrow && <Eyebrow>{why.eyebrow}</Eyebrow>}
        {why.title && <h2 class="h-display">{why.title}</h2>}
      </div>
      <div class="offset__body">
        {(why.body ?? []).map((p) => <p class="lead">{p}</p>)}
      </div>
    </Reveal>

    <Reveal stagger={110} class="figures">
      {
        (why.items ?? []).map((item) => (
          <StatCard
            value={item.value ?? ''}
            label={item.title}
            source={item.source}
            sourceHref={item.sourceHref}
            class="figures__item"
          />
        ))
      }
    </Reveal>

    {why.note && <p class="note">{why.note}</p>}

    <Botanical plate="sprig" size={132} class="deco deco--why" />
  </Section>

  {/* ============ Full-bleed break ===================================== */}
  <Section surface="cream" bleed accent="harvest">
    <Photo
      photo="break-produce"
      alt={bundle.title ?? ''}
      aspect="21 / 9"
      wipe="up"
      class="fullbleed"
    />
  </Section>

  {/* ============ 02 — HOW. The dark chapter ========================== */}
  <Section accent="harvest" surface="ink" id={how.id} numeral="02" rhythm="loose">
    <Reveal stagger={130} class="offset">
      <div class="offset__lead">
        {how.eyebrow && <Eyebrow>{how.eyebrow}</Eyebrow>}
        {how.title && <h2 class="h-display h-display--inverse">{how.title}</h2>}
      </div>
    </Reveal>
    <Steps steps={steps} class="process" />
    <Botanical plate="vine" size={150} class="deco deco--how" />
  </Section>

  {/* ============ 03 — BUNDLE. Narrow text, tall image ================ */}
  <Section accent="harvest" surface="sand" id={bundle.id} numeral="03">
    <div class="split">
      <Reveal stagger={140} class="split__text">
        <div>
          {bundle.eyebrow && <Eyebrow>{bundle.eyebrow}</Eyebrow>}
          {bundle.title && <h2 class="h-display">{bundle.title}</h2>}
        </div>
        <div>
          {(bundle.body ?? []).map((p) => <p class="lead">{p}</p>)}
          {bundle.note && <p class="note note--tight">{bundle.note}</p>}
        </div>
      </Reveal>

      <div class="split__media">
        <Photo photo="bundle" alt={bundle.title ?? ''} aspect="4 / 5" wipe="up" />
      </div>
    </div>
  </Section>

  {/* ============ 04 — FOUNDERS ======================================= */}
  <Section accent="care" surface="cream" id={founders.id} numeral="04">
    <Reveal stagger={130} class="offset">
      <div class="offset__lead">
        {founders.eyebrow && <Eyebrow>{founders.eyebrow}</Eyebrow>}
        {founders.title && <h2 class="h-display">{founders.title}</h2>}
      </div>
    </Reveal>

    <div class="founders">
      {
        /* One choreographed pair. `data-photo-group` tells the motion gate to
          count them as a single gesture, which is what they are. */
      }
      <div class="founders__portraits" data-photo-group>
        <Photo photo="founder-kreeshma" alt={founders.items?.[0]?.title ?? ''} wipe="up" />
        <Photo photo="founder-charishya" alt={founders.items?.[1]?.title ?? ''} wipe="up" />
      </div>
      <Cards
        items={[...(founders.items ?? [])]}
        columns={2}
        variant="plain"
        class="founders__bios"
      />
    </div>

    {(founders.body ?? []).map((p) => <p class="note">{p}</p>)}
  </Section>

  {/* ============ 05 — IMPACT ========================================= */}
  <Section accent="care" surface="parchment" id={impact.id} numeral="05">
    <Reveal stagger={130} class="offset">
      <div class="offset__lead">
        {impact.eyebrow && <Eyebrow>{impact.eyebrow}</Eyebrow>}
        {impact.title && <h2 class="h-display">{impact.title}</h2>}
      </div>
      <div class="offset__body">
        {(impact.body ?? []).map((p) => <p class="lead">{p}</p>)}
      </div>
    </Reveal>

    <Reveal stagger={110} class="figures">
      {
        impactStats.map((s) => (
          <StatCard value={String(s.value)} label={s.label} countUp class="figures__item" />
        ))
      }
    </Reveal>

    <p class="note">{t('impact.updated')}: {IMPACT.lastUpdated}</p>
  </Section>

  {/* ============ 06 — CTA ============================================ */}
  <Section accent="grow" surface="cream" id={cta.id} numeral="06" rhythm="loose">
    <Reveal stagger={130} class="offset">
      <div class="offset__lead">
        {cta.eyebrow && <Eyebrow>{cta.eyebrow}</Eyebrow>}
        {cta.title && <h2 class="h-display">{cta.title}</h2>}
      </div>
    </Reveal>

    <Cards items={[...(cta.items ?? [])]} columns={3} class="cta-cards" />

    <Reveal class="actions">
      {
        (cta.ctas ?? []).map((c) => (
          <Button
            href={localizePath(c.href, locale)}
            variant={c.primary ? 'primary' : 'secondary'}
            size="lg"
          >
            {c.label}
          </Button>
        ))
      }
    </Reveal>

    <Botanical plate="leafpair" size={120} class="deco deco--cta" />
  </Section>
</Base>

<style>
  /* ================= HERO ============================================== */
  .hero {
    position: relative;
    isolation: isolate;
    display: grid;
    /* Media and content share one cell, so the type sits over the photograph
       without either being positioned absolutely. */
    grid-template-areas: 'stack';
    /* `minmax(0, 1fr)`, not `auto`. The hero photo has an aspect-ratio and is
       stretched to the hero's height, and an aspect-ratio box with a definite
       height resolves its WIDTH from that height — 1354px here. An auto-sized
       grid column then grows to fit it and the whole page scrolls sideways.
       Pinning the column makes the width authoritative instead. This is the
       second time this exact interaction has bitten; see Photo.astro's
       `width: 100%`. */
    grid-template-columns: minmax(0, 1fr);
    min-height: min(94svh, 54rem);
    align-items: end;
    /* Belt and braces: the photograph is decorative and may be cropped. */
    overflow: hidden;
  }

  .hero__media,
  .hero__content {
    grid-area: stack;
  }

  .hero__media {
    position: relative;
    height: 100%;
  }

  .hero__photo {
    height: 100%;
    border-radius: 0;
  }

  .hero__content {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: var(--container-page);
    margin-inline: auto;
    padding-inline: var(--spacing-gutter);
    padding-block: clamp(3rem, 9vh, 7rem);
    color: var(--color-ink-inverse);
  }

  .hero__eyebrow {
    font-size: var(--text-eyebrow);
    font-weight: 600;
    letter-spacing: var(--text-eyebrow--letter-spacing);
    text-transform: uppercase;
    color: var(--color-ink-inverse);
    opacity: 0.85;
    margin-bottom: 1.25rem;
  }

  /* The scale-contrast moment the whole page is built around. */
  .hero__title {
    font-size: var(--text-mega);
    line-height: var(--text-mega--line-height);
    letter-spacing: var(--text-mega--letter-spacing);
    font-weight: 600;
    color: var(--color-ink-inverse);
    max-width: 15ch;
  }

  .hero__lead {
    margin-top: 1.75rem;
    max-width: 46ch;
    font-size: var(--text-lead);
    line-height: var(--text-lead--line-height);
    color: var(--color-ink-inverse);
    opacity: 0.92;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.875rem;
    margin-top: 2.25rem;
  }

  /* A secondary button on a photograph needs its own border and label colour;
     the clay-on-cream pairing used on light bands disappears here. */
  .hero__actions :global(.btn-on-dark) {
    border-color: rgb(253 251 246 / 0.5);
    color: var(--color-ink-inverse);
  }

  .hero__actions :global(.btn-on-dark:hover) {
    border-color: var(--color-ink-inverse);
    background-color: rgb(253 251 246 / 0.12);
  }

  /* ================= EDITORIAL GRID ==================================== */
  /* Heading in the left six columns, supporting prose offset into the right
     five. Stacked below the breakpoint. */
  .offset {
    display: grid;
    gap: 1.5rem;
  }

  @media (min-width: 60rem) {
    .offset {
      grid-template-columns: repeat(12, 1fr);
      gap: 2rem 3rem;
      align-items: start;
    }
    .offset__lead {
      grid-column: 1 / span 6;
    }
    .offset__body {
      grid-column: 8 / span 5;
      /* Optical alignment: sits the prose against the heading's baseline
         rather than its cap height. */
      padding-top: 0.6rem;
    }
  }

  .h-display {
    font-size: var(--text-display);
    line-height: var(--text-display--line-height);
    letter-spacing: var(--text-display--letter-spacing);
    color: var(--text-heading);
    max-width: 16ch;
    text-wrap: balance;
  }

  .h-display--inverse {
    color: var(--color-ink-inverse);
  }

  .lead {
    max-width: 54ch;
    font-size: var(--text-lead);
    line-height: var(--text-lead--line-height);
    color: var(--text-muted);
  }

  .lead + .lead {
    margin-top: 1rem;
  }

  /* Muted ink disappears on the dark band; --color-line is the checked
     equivalent there at 12.5:1. */
  :global(.section--ink) .lead {
    color: var(--color-line);
  }

  .note {
    margin-top: 2.5rem;
    max-width: 62ch;
    font-size: var(--text-small);
    line-height: 1.6;
    color: var(--text-muted);
    border-left: 2px solid var(--rule-color);
    padding-left: 1rem;
  }

  .note--tight {
    margin-top: 1.5rem;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.875rem;
    margin-top: 2.5rem;
  }

  /* ================= FIGURES — the cited statistics ==================== */
  .figures {
    display: grid;
    gap: 2.5rem;
    margin-top: clamp(3rem, 7vh, 5rem);
    padding-top: 2.5rem;
    border-top: 1px solid var(--rule-color);
  }

  @media (min-width: 48rem) {
    .figures {
      grid-template-columns: repeat(3, 1fr);
      gap: 3rem;
    }
    /* Hairlines BETWEEN the figures rather than boxes around them. */
    .figures__item + .figures__item {
      padding-left: 3rem;
      border-left: 1px solid var(--rule-color);
    }
  }

  /* ================= FULL-BLEED BREAK ================================== */
  .fullbleed {
    border-radius: 0;
    width: 100%;
  }

  /* ================= SPLIT — bundle ==================================== */
  .split {
    display: grid;
    gap: 2.5rem;
  }

  .split__text {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  @media (min-width: 60rem) {
    .split {
      grid-template-columns: repeat(12, 1fr);
      gap: 4rem;
      align-items: center;
    }
    .split__text {
      grid-column: 1 / span 5;
    }
    .split__media {
      grid-column: 7 / span 6;
    }
  }

  /* ================= FOUNDERS ========================================== */
  .founders {
    display: grid;
    gap: 2rem;
    margin-top: 3rem;
  }

  .founders__portraits {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.25rem;
  }

  @media (min-width: 60rem) {
    .founders {
      grid-template-columns: 5fr 6fr;
      gap: 3.5rem;
      align-items: center;
    }
  }

  .process,
  .cta-cards {
    margin-top: clamp(2.5rem, 6vh, 4rem);
  }

  /* ================= BOTANICAL DECORATION ============================== */
  /* Margin ornament, shown only where there is a margin to put it in.
     Squeezed against the text column it would be clutter, not detail. */
  .deco {
    display: none;
    position: absolute;
    color: var(--color-leaf);
    opacity: 0.5;
    pointer-events: none;
  }

  :global(.section--ink) .deco {
    color: var(--color-clay-soft);
    opacity: 0.4;
  }

  @media (min-width: 82rem) {
    .deco {
      display: block;
    }
    .deco--why {
      top: -1rem;
      right: -1rem;
    }
    .deco--how {
      bottom: -2rem;
      right: -1rem;
      transform: scaleX(-1);
    }
    .deco--cta {
      top: 0;
      right: -1rem;
    }
  }
</style>
