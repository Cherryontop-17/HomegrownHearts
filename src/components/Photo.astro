---
/**
 * A photo slot.
 *
 * Renders the real photograph if one exists in `src/assets/photos/`, and a
 * generated on-brand stand-in if it does not. The page never knows which it
 * got, so no component changes when the founders finally take the pictures —
 * they drop `<id>.jpg` into that folder and it appears.
 *
 * The lookup is `import.meta.glob` with `eager`, which resolves at build time.
 * A missing file is therefore not an error; it is simply an absent key.
 */

import { Image } from 'astro:assets';
import { PHOTO_SLOTS, type PhotoId } from '../photos';

interface Props {
  photo: PhotoId;
  /**
   * Alt text. Required for `meaningful` slots and rejected for `decorative`
   * ones — see the check below. Not optional-by-default on purpose: a photo
   * component that lets you forget alt text is how sites fail an audit.
   */
  alt?: string;
  /** Rendered width hint for srcset generation. */
  width?: number;
  /** Above the fold. Skips lazy-loading and raises fetch priority. */
  eager?: boolean;
  /**
   * Slow 20s drift. Only applies to a real photograph — a gradient stand-in has
   * nothing to pan across, and moving it would just be motion for its own sake.
   */
  kenBurns?: boolean;
  /**
   * Darkening overlay for text laid over the image.
   *
   * Not a taste setting. The opacity is chosen so that cream text clears WCAG
   * AA **against a pure-white photograph** — the lightest background the
   * composite can ever produce. That makes contrast a property of the scrim
   * rather than a property of whichever photo the founders happen to upload,
   * which is the only way to guarantee it for images that do not exist yet.
   * Measured worst case: 5.8:1.
   */
  scrim?: boolean;
  /**
   * Enter by clip-wipe rather than fade. The frame opens and the picture
   * settles inside it. Costs zero CLS because the box is already at its final
   * size throughout — only `clip-path` and a counter-scale change.
   */
  wipe?: false | 'up' | 'in';
  /** Crop override. Defaults to the slot's declared aspect. */
  aspect?: string;
  class?: string;
}

const {
  photo,
  alt,
  width = 1200,
  eager = false,
  kenBurns = false,
  scrim = false,
  wipe = false,
  aspect,
  class: className,
  ...rest
} = Astro.props;

const slot = PHOTO_SLOTS[photo];

if (slot.role === 'meaningful' && !alt) {
  throw new Error(
    `Photo "${photo}" is a meaningful image and needs an \`alt\`. ` +
      `If it is purely decorative, change its role in src/photos.ts instead of ` +
      `inventing alt text for it.`,
  );
}

// Eager so the manifest resolves at build time rather than returning promises.
const files = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/photos/*.{jpg,jpeg,png,webp,avif}',
  { eager: true },
);

const match = Object.entries(files).find(([path]) => {
  const name = path
    .split('/')
    .pop()
    ?.replace(/\.[^.]+$/, '');
  return name === slot.id;
});

const source = match?.[1].default;

// Decorative images take alt="" — an empty alt is a real instruction to a
// screen reader ("skip this"), not a missing one.
const altText = slot.role === 'decorative' ? '' : (alt ?? '');

/**
 * Two-stop gradient per tone, plus a vine motif. Deterministic, so a given slot
 * always renders the same stand-in and screenshots stay stable.
 */
const TONES = {
  garden: { from: 'var(--color-season-grow)', to: 'var(--color-leaf)' },
  harvest: { from: 'var(--color-season-harvest)', to: 'var(--color-clay-soft)' },
  care: { from: 'var(--color-clay)', to: 'var(--color-clay-soft)' },
} as const;

const tone = TONES[slot.tone];
---

<figure
  class:list={['photo', scrim && 'photo--scrim', wipe && `photo--wipe-${wipe}`, className]}
  style={`--photo-aspect:${aspect ?? slot.aspect};--tone-from:${tone.from};--tone-to:${tone.to}`}
  data-photo
  {...rest}
>
  {
    source ? (
      <Image
        src={source}
        alt={altText}
        width={width}
        densities={[1, 2]}
        loading={eager ? 'eager' : 'lazy'}
        fetchpriority={eager ? 'high' : undefined}
        decoding={eager ? 'sync' : 'async'}
        class:list={['photo__img', kenBurns && 'photo__img--drift']}
      />
    ) : (
      /*
        Stand-in. `aria-hidden` because it depicts nothing — announcing a
        gradient to a screen reader as though it were the photograph would be
        worse than silence. The surrounding copy carries the meaning until a
        real image lands.
      */
      <div class="photo__placeholder" aria-hidden="true" data-photo-slot={slot.id}>
        <svg class="photo__motif" viewBox="0 0 200 120" preserveAspectRatio="xMidYMid slice">
          <path
            class="photo__vine"
            d="M-10 110 C 40 110 30 60 70 58 C 110 56 100 12 150 14 C 180 15 195 8 210 4"
          />
          <path class="photo__leaf" d="M70 58C58 52 52 40 54 28C66 32 72 45 70 58Z" />
          <path class="photo__leaf" d="M150 14C140 6 138 -6 143 -16C153 -9 155 4 150 14Z" />
        </svg>
      </div>
    )
  }
  {scrim && <span class="photo__scrim" aria-hidden="true" />}
  <div class="photo__overlay"><slot /></div>
</figure>

<script>
  /**
   * Opens a photo's clip once it enters view. Separate from Reveal because a
   * photograph wipes rather than fades, and because the two must not double up
   * on the same element — a fade inside a wipe reads as a rendering fault.
   *
   * Once-only, like every other reveal on the site.
   */
  function initPhotoWipes() {
    const shots = document.querySelectorAll<HTMLElement>(
      '[data-photo][class*="photo--wipe"]:not(.is-shown)',
    );
    if (shots.length === 0) return;

    if (!('IntersectionObserver' in window)) {
      shots.forEach((el) => el.classList.add('is-shown'));
      return;
    }

    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          entry.target.classList.add('is-shown');
          observer.unobserve(entry.target);
        }
      },
      { rootMargin: '0px 0px -12% 0px', threshold: 0.15 },
    );

    shots.forEach((el) => observer.observe(el));
  }

  initPhotoWipes();
  document.addEventListener('astro:page-load', initPhotoWipes);
</script>

<style>
  .photo {
    position: relative;
    margin: 0;
    /* Explicit, and load-bearing. With `aspect-ratio` set and width left at
       `auto`, a `min-height` (see .photo--scrim) makes the box resolve its
       WIDTH from its height — which pushed the hero 10px past a 768px viewport.
       Pinning the width means height derives from width, and min-height can
       only stretch it. Caught by `npm run check:overflow`. */
    width: 100%;
    /* Reserved before anything loads. This is what keeps CLS at zero when a
       real photo replaces a stand-in. */
    aspect-ratio: var(--photo-aspect);
    overflow: hidden;
    border-radius: var(--radius-lg);
    background-color: var(--color-sand);
  }

  .photo__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* Strongest where the text sits, clearing toward the far edge so the
     photograph is still visible. 0.7 at the text end is the measured floor. */
  .photo__scrim {
    position: absolute;
    inset: 0;
    background-image: linear-gradient(
      100deg,
      rgb(34 32 29 / 0.7) 0%,
      rgb(34 32 29 / 0.58) 42%,
      rgb(34 32 29 / 0.25) 100%
    );
    pointer-events: none;
  }

  .photo__overlay {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    /* Only participates in layout when something is slotted in. */
    pointer-events: none;
  }

  .photo__overlay > :global(*) {
    pointer-events: auto;
  }

  .photo--scrim {
    /* Text needs room to breathe on a short viewport. */
    min-height: 26rem;
  }

  /* --- Clip wipe entrance ------------------------------------------------
     The clip goes on the INNER media, never on the <figure> itself.

     That is not a style choice. The figure is what IntersectionObserver
     watches, and an element clipped to `inset(100% 0 0 0)` has no visible area
     for the observer to intersect — so it could never become visible in order
     to be revealed. The first version did exactly that and the observer sat at
     zero hits forever while four photographs stayed invisible.

     Gated on `.js` like every other reveal: without scripting the photograph is
     simply visible, never stuck behind a clip that will not open. */
  :global(.js) .photo--wipe-up .photo__img,
  :global(.js) .photo--wipe-up .photo__placeholder {
    clip-path: inset(100% 0 0 0);
  }

  :global(.js) .photo--wipe-in .photo__img,
  :global(.js) .photo--wipe-in .photo__placeholder {
    clip-path: inset(0 100% 0 0);
  }

  :global(.js) .photo--wipe-up.is-shown .photo__img,
  :global(.js) .photo--wipe-up.is-shown .photo__placeholder {
    animation: clip-wipe-up var(--duration-slow) var(--ease-out-gentle) forwards;
  }

  /* A deliberately paired set opens in sequence rather than together. */
  :global([data-photo-group]) .photo:nth-child(2).is-shown .photo__img,
  :global([data-photo-group]) .photo:nth-child(2).is-shown .photo__placeholder {
    animation-delay: 140ms;
  }

  :global(.js) .photo--wipe-in.is-shown .photo__img,
  :global(.js) .photo--wipe-in.is-shown .photo__placeholder {
    animation: clip-wipe-in var(--duration-slow) var(--ease-out-gentle) forwards;
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.js) .photo--wipe-up .photo__img,
    :global(.js) .photo--wipe-up .photo__placeholder,
    :global(.js) .photo--wipe-in .photo__img,
    :global(.js) .photo--wipe-in .photo__placeholder,
    :global(.js) .photo--wipe-up.is-shown .photo__img,
    :global(.js) .photo--wipe-up.is-shown .photo__placeholder,
    :global(.js) .photo--wipe-in.is-shown .photo__img,
    :global(.js) .photo--wipe-in.is-shown .photo__placeholder {
      clip-path: none;
      animation: none;
    }
  }

  /* 20s, 1.06 ceiling. Slow and shallow enough to read as the image breathing
     rather than panning — see the note in motion.css. `alternate` so it drifts
     back instead of snapping to the start. */
  .photo__img--drift {
    animation: ken-burns 20s var(--ease-in-out-soft) infinite alternate;
    will-change: transform;
  }

  @media (prefers-reduced-motion: reduce) {
    .photo__img--drift {
      animation: none;
    }
  }

  .photo__placeholder {
    width: 100%;
    height: 100%;
    position: relative;
    background-image: linear-gradient(145deg, var(--tone-from), var(--tone-to));
    /* Muted so a stand-in never competes with real content for attention.
       It should read as "an image belongs here", not as a design element. */
    opacity: 0.5;
  }

  .photo__motif {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    fill: none;
    stroke: var(--color-cream);
    stroke-width: 1.5;
    stroke-linecap: round;
    opacity: 0.5;
  }

  .photo__leaf {
    fill: var(--color-cream);
    stroke: none;
    opacity: 0.7;
  }
</style>
