---
/**
 * Button / link primitive.
 *
 * Renders an `<a>` when given an `href` and a `<button>` otherwise. That
 * distinction is not cosmetic: a link navigates and belongs in the tab order
 * with link semantics, a button acts. Styling one to look like the other is
 * fine; swapping the element is not.
 *
 * Garden is the action color and appears on primary buttons and nowhere else on
 * the site. Holding that line is most of what keeps the palette feeling
 * deliberate rather than decorated.
 */

import Icon from './Icon.astro';

interface Props {
  href?: string;
  variant?: 'primary' | 'secondary' | 'ghost';
  size?: 'md' | 'lg';
  /** Native button type. Ignored when `href` is set. */
  type?: 'button' | 'submit';
  /** Marks an href as leaving the site: opens a new tab, adds rel + a11y hint. */
  external?: boolean;
  disabled?: boolean;
  class?: string;
}

const {
  href,
  variant = 'primary',
  size = 'md',
  type = 'button',
  external = false,
  disabled = false,
  class: className,
  ...rest
} = Astro.props;

const Tag = href ? 'a' : 'button';

// The two element types take different attributes, so this is a union that no
// single JSX signature accepts. Widened deliberately — `Tag` is resolved at
// runtime, and the branch above already guarantees the pairing is correct.
const attrs: Record<string, unknown> = href
  ? {
      href,
      ...(external ? { target: '_blank', rel: 'noopener noreferrer' } : {}),
      // A disabled link is not a thing; remove it from the tab order instead.
      ...(disabled ? { 'aria-disabled': 'true', tabindex: -1 } : {}),
    }
  : { type, disabled };
---

<Tag class:list={['btn', `btn--${variant}`, `btn--${size}`, className]} {...rest} {...attrs}>
  {
    /*
    Leaf unfurl — the one flourish on the site, reserved for the primary
    action. Decorative and hover-only, so it can never be the sole indication
    of anything; touch users lose nothing by not seeing it.
  */
  }
  {
    variant === 'primary' && (
      <svg class="btn__leaf" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path d="M12 20C7.2 17.4 4 12.8 3.4 6.4C9.8 7.4 13.4 12.4 12 20Z" />
      </svg>
    )
  }
  <span class="btn__label"><slot /></span>
  {external && <Icon name="arrow-up-right" size={16} class="btn__external" />}
</Tag>

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    /* 44px floor on both axes — the WCAG target-size minimum, and the reason
       padding alone is not enough on a short label. */
    min-height: 44px;
    min-width: 44px;
    padding: 0.75rem 1.5rem;
    border: 1px solid transparent;
    border-radius: var(--radius-pill);
    font-family: var(--font-body);
    font-size: var(--text-small);
    font-weight: 600;
    line-height: 1.2;
    text-align: center;
    text-decoration: none;
    cursor: pointer;
    transition:
      background-color var(--duration-fast) var(--ease-out-soft),
      border-color var(--duration-fast) var(--ease-out-soft),
      color var(--duration-fast) var(--ease-out-soft),
      /* Overshoot on the transform only — it settles past the target and
         back, which is the whole difference between springy and merely moved. */
      transform var(--duration-fast) var(--ease-overshoot),
      box-shadow var(--duration-fast) var(--ease-out-soft);
  }

  .btn--lg {
    padding: 1rem 2rem;
    font-size: var(--text-body);
  }

  /* --- Primary: the only place garden appears ---------------------------- */
  .btn--primary {
    background-color: var(--color-garden);
    color: var(--color-ink-inverse);
    box-shadow: var(--shadow-soft);
  }

  .btn--primary:hover {
    background-color: var(--color-garden-deep);
  }

  /* --- Secondary: outlined clay ------------------------------------------ */
  .btn--secondary {
    background-color: transparent;
    border-color: var(--color-line-strong);
    color: var(--color-clay);
  }

  .btn--secondary:hover {
    border-color: var(--color-clay);
    background-color: color-mix(in oklab, var(--color-clay) 6%, transparent);
  }

  /* --- Ghost: text-weight action ----------------------------------------- */
  .btn--ghost {
    background-color: transparent;
    color: var(--color-clay);
    padding-inline: 0.75rem;
  }

  .btn--ghost:hover {
    color: var(--color-clay-deep);
    background-color: color-mix(in oklab, var(--color-clay) 6%, transparent);
  }

  /* Lift is the site's one shared hover gesture. 1px — enough to feel
     responsive, not enough to read as a toy. */
  /*
    A springier hover than a 1px nudge.

    `--ease-overshoot` is already in the token set and never used; it slightly
    passes the target and settles back, which is what reads as "springy" rather
    than "moved". Scale plus lift, both transform-only so neither can shift
    layout or cost CLS.

    The travel is deliberately small. This is a button on a site for people who
    may be nauseated — it should feel alive when you touch it, not leap.
  */
  .btn:hover:not([aria-disabled='true']):not(:disabled) {
    transform: translateY(-2px) scale(1.03);
  }

  /* The arrow, where a button has one, runs ahead on hover. */
  .btn:hover:not([aria-disabled='true']):not(:disabled) :global(.icon) {
    translate: 3px 0;
  }

  .btn :global(.icon) {
    transition: translate var(--duration-fast) var(--ease-out-soft);
  }

  .btn--primary:hover:not([aria-disabled='true']):not(:disabled) {
    box-shadow: var(--shadow-lift);
  }

  /* Press compresses below the resting size, so the button feels physical. */
  .btn:active:not([aria-disabled='true']):not(:disabled) {
    transform: translateY(0) scale(0.97);
    transition-duration: 90ms;
  }

  .btn:disabled,
  .btn[aria-disabled='true'] {
    opacity: 0.5;
    cursor: not-allowed;
    box-shadow: none;
  }

  /* Nudged up so the arrow reads as leaving the label, not sitting on it. */
  .btn__external {
    margin-inline-start: -0.125rem;
  }

  /* --- Leaf unfurl --------------------------------------------------------
     Collapsed to zero width at rest, so it costs no layout until it opens. It
     unfurls by rotating about its own stem rather than sliding, which is what
     makes it read as growing rather than as an icon appearing. */
  .btn__leaf {
    width: 0;
    height: 1.05em;
    flex: none;
    fill: currentColor;
    opacity: 0;
    transform: rotate(-35deg) scale(0.5);
    transform-origin: 12px 20px;
    transition:
      width var(--duration-fast) var(--ease-out-soft),
      opacity var(--duration-fast) var(--ease-out-soft),
      transform var(--duration-base) var(--ease-overshoot);
  }

  .btn--primary:hover .btn__leaf,
  .btn--primary:focus-visible .btn__leaf {
    width: 1.05em;
    opacity: 0.9;
    transform: rotate(0deg) scale(1);
  }

  @media (prefers-reduced-motion: reduce) {
    .btn__leaf {
      transition: none;
    }
  }

  /* The global kill-switch already zeroes the durations; this also removes the
     displacement itself, which is the part that actually causes discomfort. */
  @media (prefers-reduced-motion: reduce) {
    .btn:hover:not([aria-disabled='true']):not(:disabled),
    .btn:active {
      transform: none;
    }
  }
</style>
