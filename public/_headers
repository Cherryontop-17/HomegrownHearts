# Security headers, served by Cloudflare static assets (task 6.7).
#
# Cloudflare's adapter appends its own immutable Cache-Control block for
# /_astro/* during the build, so this file only carries what the build does not.
#
# ⚠️ The CSP is the one header here that can break the site silently. Verified
# against the built output by `npm run check:headers`, which loads every route
# in a real browser and fails on any CSP violation — a policy nobody tested is
# just a header.

/*
  # Clickjacking. No page here is meant to be framed.
  X-Frame-Options: DENY

  # Stops a browser second-guessing a declared Content-Type.
  X-Content-Type-Options: nosniff

  # Send the origin cross-site, the full path same-site. Enough for a partner
  # clinic to see traffic came from us, without leaking which page a reader
  # was on.
  Referrer-Policy: strict-origin-when-cross-origin

  # This site asks for no device permissions at all. Denying them outright
  # means a future dependency cannot quietly start asking.
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=(), payment=(), usb=(), magnetometer=(), gyroscope=(), accelerometer=()

  # HSTS. Two years, subdomains included, preload-eligible.
  # Only meaningful once the custom domain is live and serving HTTPS — see
  # docs/DEPLOY.md before submitting to the preload list, because it is very
  # hard to undo.
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload

  # Content Security Policy.
  #
  # 'unsafe-inline' on script-src is required and deliberate: Astro inlines
  # the `.js` class setter and the View Transitions bootstrap directly in the
  # document head. Removing it would blank the page for everyone. The correct
  # fix is per-request nonces, which a fully static site cannot issue — noted
  # as accepted debt rather than pretended away.
  #
  # 'unsafe-inline' on style-src is likewise required: Astro inlines scoped
  # component CSS, and several components set custom properties via the
  # `style` attribute.
  #
  # Everything else is locked to self. The site loads no third-party script,
  # font, or analytics — that is a deliberate property worth enforcing, not
  # just describing.
  #
  # `frame-src` is the one third-party allowance in this policy. It exists for
  # the drop-off maps on /get-involved/drop-off/, and it is narrow on purpose:
  # Google may be framed, and nothing else may be. Note that nothing is
  # actually requested from Google until a reader presses "Show map" — see the
  # header of src/components/MapEmbed.astro for why the embed is click-to-load.
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; form-action 'self'; frame-src https://www.google.com https://maps.google.com; frame-ancestors 'none'; base-uri 'self'; object-src 'none'; manifest-src 'self'; upgrade-insecure-requests

# Fonts are content-hashed by name and never change in place.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Brand assets change only when `npm run brand` is re-run.
/og/*
  Cache-Control: public, max-age=604800

# HTML must revalidate, or a founder's copy edit takes a week to appear.
/*.html
  Cache-Control: public, max-age=0, must-revalidate
