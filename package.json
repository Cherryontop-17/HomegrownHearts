    "check:fonts": "python scripts/check-font-coverage.py",
    "check:i18n": "node scripts/check-i18n-urls.mjs",
    "check:overflow": "node scripts/check-overflow.mjs",
    "check:motion": "node scripts/check-motion.mjs",
    "check:headers": "node scripts/check-headers.mjs",
    "sync:fonts": "node scripts/sync-fonts.mjs",
    "sync:icons": "node scripts/sync-icons.mjs",
    "photos": "node scripts/grade-photos.mjs",
    "brand": "node scripts/generate-brand-assets.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "deploy": "astro build && wrangler deploy",
    "check:a11y": "node scripts/check-a11y.mjs",
